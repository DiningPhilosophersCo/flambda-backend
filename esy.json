    "@opam/dune": "3.15.2"
  },
  "x-devDependencies": {
    "@opam/ocaml-lsp-server": "*",
    "@opam/ocamlformat": "*",
    "@opam/ocamlformat-rpc": "*",
    "@opam/utop": "*"
  },
  "resolutions": {}
}
