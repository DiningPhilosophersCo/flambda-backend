  "esy": {
    "buildsInSource": "unsafe",
    "build": [
      "./configure #{os == 'windows' ? '--host=x86_64-w64-mingw32': ''} --prefix='#{self.install}'",
      "make"
    ],
    "install": "make install"
  },
  "dependencies": {
    "ocaml": "4.14.x",
    "@opam/menhir": "20231231",
